{
  "expo": {
    "name": "FarmaCheck",
    "slug": "farmacheck",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/farmacheck.png",
    "scheme": "farmacheck",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#EAF2FF",
        "foregroundImage": "./assets/images/farmacheck.png",
        "monochromeImage": "./assets/images/farmacheck.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.myzel.AppDeValidade"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/farmacheck.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/farmacheck.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#151B54",
          "dark": {
            "backgroundColor": "#151B54"
          }
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5989ec17-29bd-412f-9db5-29c44a419909"
      }
    }
  }
}
